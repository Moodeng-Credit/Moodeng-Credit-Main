# Copy to .env and fill in. NEVER commit the real .env (it's gitignored).

# RPC for the target network (Base mainnet shown; use a Base Sepolia URL to test first)
BASE_RPC_URL=https://mainnet.base.org

# Deployer wallet private key — pays gas to deploy and receives admin/originator roles
# unless ADMIN_ADDRESS differs. Keep secret.
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# Constructor args
# USDC on Base mainnet:
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# The Moodeng funding wallet — gets DEFAULT_ADMIN_ROLE + ADMIN_ROLE + ORIGINATOR_ROLE:
ADMIN_ADDRESS=0xYOUR_MOODENG_FUNDING_WALLET

# Optional: Basescan API key for `--verify` contract verification
BASESCAN_API_KEY=
