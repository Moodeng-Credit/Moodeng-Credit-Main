{
  "buildCommand": "NODE_OPTIONS=--max-old-space-size=8192 pnpm exec vite build && node scripts/prerender-seo.mjs",
  "routes": [
    { "src": "^/$", "dest": "/landing/index.html" },
    { "src": "^/how-it-works/?$", "dest": "/landing/how-it-works.html" },
    { "src": "^/how-to-cash-out/?$", "dest": "/landing/how-to-cash-out.html" },
    { "src": "^/how-to-repay/?$", "dest": "/landing/how-to-repay.html" },
    { "src": "^/credit-levels/?$", "dest": "/landing/credit-levels.html" },
    { "src": "^/about/?$", "dest": "/landing/about.html" },
    { "src": "^/for-lenders/?$", "dest": "/landing/for-lenders.html" },

    { "src": "^/b2b-demo/?$", "dest": "/demo-b2b/platform.html" },

    { "src": "^/b2c-dashboard-mockup/?$", "dest": "/demo-b2c/dashboard-mockup.html" },
    { "src": "^/b2c-dashboard-mockup-assets/?$", "dest": "/demo-b2c/assets.html" },

    { "src": "^/blogs/?$", "dest": "/blogs/index.html" },
    { "src": "^/blogs/([^/]+)/?$", "dest": "/blogs/$1/index.html" },
    { "src": "^/academy/money/([^/]+)/?$", "dest": "/academy/money/$1/index.html" },
    { "src": "^/academy/money/?$", "dest": "/academy/money/index.html" },
    { "src": "^/academy/?$", "dest": "/academy/index.html" },
    { "src": "^/learn/([^/]+)/?$", "dest": "/learn/$1/index.html" },
    { "src": "^/learn/?$", "dest": "/learn/index.html" },
    { "src": "^/support/faq/?$", "dest": "/support/faq/index.html" },
    { "src": "^/support/getting-started/?$", "dest": "/support/getting-started/index.html" },
    { "src": "^/benefits/?$", "dest": "/benefits/index.html" },
    { "src": "^/whylend/?$", "dest": "/whylend/index.html" },
    { "src": "^/team/?$", "dest": "/team/index.html" },
    { "src": "^/credit-leveling-guide/?$", "dest": "/credit-leveling-guide/index.html" },
    { "src": "^/privacy/?$", "dest": "/privacy/index.html" },
    { "src": "^/privacy-policy/?$", "dest": "/privacy-policy/index.html" },
    { "src": "^/terms/?$", "dest": "/terms/index.html" },
    { "src": "^/data-deletion/?$", "dest": "/data-deletion/index.html" },

    {
      "src": "^/assets/(.*)\\.wasm$",
      "headers": { "Content-Type": "application/wasm" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "^/.*$", "dest": "/index.html" }
  ]
}
