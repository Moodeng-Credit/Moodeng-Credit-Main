<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>app.moodeng.messenger-relay</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/georgelerner/.moodeng-messenger-relay/relay.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/georgelerner/.moodeng-messenger-relay</string>
  <key>StartInterval</key><integer>1800</integer>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/georgelerner/.moodeng-messenger-relay/relay.log</string>
  <key>StandardErrorPath</key><string>/Users/georgelerner/.moodeng-messenger-relay/relay.log</string>
</dict>
</plist>
